VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# WebSocket URL for the real-time pollution heat-map (server/heatmap-ws-server.js).
# Defaults to ws://localhost:8081 if not set. If unreachable, the map falls back
# to REST polling automatically.
VITE_WS_URL=ws://localhost:8081

# AI Pollution Copilot (see src/services/aiCopilotService.js). Optional — if
# unset, the copilot uses a built-in rule-based fallback and works with no
# configuration at all. To connect a real AI backend, point this at your own
# server-side proxy (never call a third-party AI API directly from the
# browser with an embedded key).
VITE_AI_COPILOT_API_URL=
VITE_AI_COPILOT_API_KEY=